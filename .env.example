# =============================================================================
# The Lenny Growth Assistant — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================


# =============================================================================
# LLM Provider — choose one: "ollama", "anthropic", or "openai"
# =============================================================================

LLM_PROVIDER=ollama

# --- Ollama (local, required for demo) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b


# --- Anthropic Claude (optional, cloud) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- OpenAI (optional, cloud) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# =============================================================================
# PostgreSQL Database
# =============================================================================
# For Docker Compose: use the default values below (postgres is the service name)
# For Supabase: use your Supabase project's connection details
# For local PostgreSQL: use localhost

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny_local_dev
POSTGRES_DB=lenny_assistant

# Note: Special characters in POSTGRES_PASSWORD (@ # % etc.) are automatically
# URL-encoded by the application. You do not need to escape them manually.


# =============================================================================
# Application
# =============================================================================

APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins
# Add your frontend URL if running on a different port
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# =============================================================================
# Embeddings & Retrieval
# =============================================================================

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Number of transcript chunks to retrieve per query
RETRIEVAL_TOP_K=5

# Chunking parameters (used during ingestion)
CHUNK_SIZE=512
CHUNK_OVERLAP=50
